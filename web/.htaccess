# NightSeam static response policy for /astro.
# The planner also carries a meta CSP in index.html. A meta policy cannot
# enforce frame-ancestors; retain this response header where Apache serves it.
# Plesk/nginx may serve static files without consulting .htaccess. See
# HOSTING_CONFIGURATION.md; verify actual HTML/module/JSON responses after an
# authorized deployment. These directives do not prove live hosting behavior.
# Inline styles are required by editing controls; script execution stays self.

<IfModule mod_headers.c>
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://upload.wikimedia.org https://thumb.wikimedia.org; connect-src 'self' https://en.wikipedia.org https://upload.wikimedia.org https://thumb.wikimedia.org https://api.open-meteo.com https://air-quality-api.open-meteo.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
Header set Cache-Control "public, max-age=0, must-revalidate"
<FilesMatch "\.(js|css|json|svg|png|jpe?g|ico|woff2?)$">
Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{QUERY_STRING} =~ m#(?:^|&)v=[0-9]+(?:&|$)#"
</FilesMatch>
<FilesMatch "^(version\.json|catalog\.manifest\.json|catalog-provenance\.manifest\.json)$">
Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>
</IfModule>

# The pairing relay (relay.php) answers once per box: never cache it, and give
# it the closed policy of an API rather than the planner's page policy. These
# Files sections merge after the directory-wide lines above and replace them.
# Needs PHP "FPM application served by Apache" (HOSTING_CONFIGURATION.md).
<Files "relay.php">
<IfModule mod_headers.c>
Header always set Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
Header always set Referrer-Policy "no-referrer"
Header set Cache-Control "no-store"
</IfModule>
</Files>
<FilesMatch "\.(php|phtml|phar)$">
<If "%{REQUEST_URI} !~ m#^/astro/relay\.php$#">
Require all denied
</If>
</FilesMatch>
